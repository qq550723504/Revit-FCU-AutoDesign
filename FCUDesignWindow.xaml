<Window x:Class="FCUAutoDesign.FCUDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCU 自动布置与接管（验证版）"
        Height="720" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0f172a" Foreground="#f8fafc"
        FontFamily="Microsoft YaHei">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="FCU 同楼层多房间布置" FontSize="16" FontWeight="Bold" Foreground="#38bdf8"/>
            <TextBlock Text="不含正式水力选径、冷凝水坡度和全模型碰撞检查" FontSize="11" Foreground="#94a3b8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 参数表单 -->
        <Border Grid.Row="1" Background="#1e293b" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border BorderBrush="#0e7490" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14" Background="#13263a">
                        <StackPanel>
                            <TextBlock Text="AI 方案助手" Foreground="#67e8f9" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="用自然语言生成参数方案。AI 不直接选择模型元素或写入 Revit；应用后只回填当前表单，点击“开始放置与接管”才执行。" TextWrapping="Wrap" Foreground="#94a3b8" FontSize="11" Margin="0,3,0,7"/>
                            <TextBox x:Name="TxtAgentRequest" MinHeight="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" Background="#0f172a" Foreground="#e2e8f0" BorderBrush="#475569" Padding="5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button x:Name="BtnAgentPlan" Content="生成方案" Width="110" Height="28" Background="#0e7490" Foreground="White" BorderThickness="0" Click="BtnAgentPlan_Click"/>
                                <Button x:Name="BtnApplyAgentPlan" Content="应用方案" Width="80" Height="28" Margin="8,0,0,0" Visibility="Collapsed" Background="#15803d" Foreground="White" BorderThickness="0" Click="BtnApplyAgentPlan_Click"/>
                                <TextBlock x:Name="TxtAgentStatus" Text="尚未生成" VerticalAlignment="Center" Foreground="#94a3b8" FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox x:Name="TxtAgentPreview" IsReadOnly="True" Visibility="Collapsed" MaxHeight="130" Margin="0,7,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0f172a" Foreground="#cbd5e1" BorderBrush="#334155" Padding="5"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="操作模式：" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbCreate" GroupName="OperationMode" Content="首次生成" IsChecked="True" Foreground="#67e8f9" Margin="0,0,20,0"/>
                        <RadioButton x:Name="RbRecalculate" GroupName="OperationMode" Content="修改重算" Foreground="#fbbf24"/>
                    </StackPanel>
                    <TextBlock Text="指定 FCU 族类型：" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="FcuTypePicker" DisplayMemberPath="Value" SelectedValuePath="Key" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="距门侧墙内侧距离 (mm):" ToolTip="FCU 定位点到门所在墙室内侧的距离；默认 500 mm。多台沿墙等距布置，两端留半间距。" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtDoorOffset" Grid.Column="1" Text="500" Background="#0f172a" Foreground="#38bdf8" BorderBrush="#475569" Padding="4"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="冷指标 (W/m²):" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtCoolingIndex" Grid.Column="1" Text="200" Background="#0f172a" Foreground="#38bdf8" BorderBrush="#475569" Padding="4"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="风盘相对标高净高 (mm):" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtFcuElevation" Grid.Column="1" Text="2600" Background="#0f172a" Foreground="#38bdf8" BorderBrush="#475569" Padding="4"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="接管目标距离 (mm):" ToolTip="FCU 接口到首个转弯中心的目标距离；400 mm 为试用默认值，并非规范值。" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtValveClearance" Grid.Column="1" Text="400" Background="#0f172a" Foreground="#34d399" BorderBrush="#475569" Padding="4"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <TextBlock Text="最小净直管 (mm，可空):" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtMinimumStraight" Grid.Column="1" Text="" ToolTip="根据实际设备、管件及安装详图填写。生成管件后检查剩余直管净长，不允许低于此值。留空时可按障碍缩短目标首段，但工程安装净长未校验。" Background="#0f172a" Foreground="#34d399" BorderBrush="#475569" Padding="4"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="避让下翻起始高差 (mm):" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="12"/>
                        <TextBox x:Name="TxtFlipDrop" Grid.Column="1" Text="150" Background="#0f172a" Foreground="#f43f5e" BorderBrush="#475569" Padding="4"/>
                    </Grid>



                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=ChkEnableCondensate}">
                        <TextBlock Text="三路均先尝试不下翻，再尝试下翻避让。目标首段可避障缩短；已填写的最小净直管不可突破，留空表示安装净长未校验。冷凝水最多试建 12 次，10 秒后停止新试建；不验证排水坡度。" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 功能控制开关 (已修复 XAML 转义与参数接通) -->
                    <Border BorderBrush="#334155" BorderThickness="0,1,0,0" Margin="0,6,0,8" Padding="0,6,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutomaticScope" Content="自动发现当前平面视图目标范围（修改重算只选择已有设计房间）" IsChecked="False" Foreground="#67e8f9" Margin="0,3,0,3" FontSize="11"/>
                            <Grid Margin="18,2,0,5" IsEnabled="{Binding IsChecked, ElementName=ChkAutomaticScope}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <TextBlock Text="房间名称关键词：" ToolTip="使用分号或逗号分隔；名称包含任一关键词即进入候选。" VerticalAlignment="Center" Foreground="#a5f3fc" FontSize="11"/>
                                <TextBox x:Name="TxtAutomaticRoomKeywords" Grid.Column="1" Text="会议室;办公室" Background="#0f172a" Foreground="#67e8f9" BorderBrush="#475569" Padding="4"/>
                            </Grid>
                            <CheckBox x:Name="ChkAutoDn" Content="正式自动选径（等待水力表及匹配依据确认）" IsChecked="False" IsEnabled="False" Foreground="#64748b" Margin="0,3,0,0" FontSize="11"/>
                            <CheckBox x:Name="ChkBusinessPreview" Content="启用负荷、台数和点位预览" IsChecked="True" Foreground="#fbbf24" Margin="0,6,0,0" FontSize="11"/>
                            <CheckBox x:Name="ChkMultipleFcus" Content="按 L/5 向上取整放置多台（均使用所选族类型）" IsChecked="True" Foreground="#fbbf24" Margin="0,6,0,0" FontSize="11"/>
                            <TextBlock Text="多台沿门侧墙等距布置，任一台接管失败则整间回滚；未自动匹配目录型号，三路支管分别采用设备实际接口尺寸。" TextWrapping="Wrap" Foreground="#94a3b8" FontSize="11"/>
                            <CheckBox x:Name="ChkEnableReturn" Content="连接走廊回水主管" IsChecked="True" Foreground="#c084fc" Margin="0,6,0,0" FontSize="11"/>
                            <CheckBox x:Name="ChkEnableCondensate" Content="选择冷凝水主管并接入（失败时回滚冷凝水操作）" IsChecked="False" Foreground="#fcd34d" Margin="0,6,0,0" FontSize="11"/>
                            <CheckBox x:Name="ChkBreakCurve" Content="供回水主管打断并插入三通（失败时回滚打断）" IsChecked="True" Foreground="#86efac" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底部触发按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="80" Height="32" Margin="0,0,10,0" Background="#334155" Foreground="#e2e8f0" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnRun" Content="确认参数并确定范围" Width="150" Height="32" Background="#0284c7" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnRun_Click"/>
        </StackPanel>
    </Grid>
</Window>
